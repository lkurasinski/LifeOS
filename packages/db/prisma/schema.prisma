// This is your Prisma schema file for LifeOS Vault (Cookbook)
// Learn more: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================
// USERS & AUTH
// ============================================

model User {
  id           Int      @id @default(autoincrement())
  email        String   @unique
  passwordHash String   @map("password_hash")
  name         String?
  locale       String   @default("pl")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  recipes Recipe[]
  foods   Food[] // Custom foods created by user

  @@map("users")
}

// ============================================
// NUTRITION (katalog składników odżywczych)
// ============================================

enum NutritionUnit {
  kJ
  kcal
  mcg
  mg
  g
  IU
  none

  @@map("nutrition_unit")
}

model Nutrition {
  id            String        @id // INFOODS tagname code (e.g., CA, PROT, VITC) - kept as string for semantic meaning
  namePl        String?       @map("name_pl")
  nameEn        String        @map("name_en")
  unit          NutritionUnit
  descriptionPl String?       @map("description_pl") @db.Text
  descriptionEn String?       @map("description_en") @db.Text
  commentPl     String?       @map("comment_pl") @db.Text
  commentEn     String?       @map("comment_en") @db.Text
  categoryId    String?       @map("category_id") // Reference to parent category

  foodNutritions FoodNutrition[]

  @@map("nutrition")
}

// ============================================
// FOOD (produkty spożywcze)
// ============================================

model Food {
  id             Int     @id @default(autoincrement())
  namePl         String? @map("name_pl")
  nameEn         String  @map("name_en")
  scientificName String? @map("scientific_name")
  category       String?
  brand          String?
  userId         Int?    @map("user_id")

  // Source tracking
  sourceProvider   String? @map("source_provider") // 'fdc', 'openfoodfacts', 'custom'
  sourceExternalId String? @map("source_external_id") // External ID from source
  sourceUrl        String? @map("source_url") // URL to source detail page

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user              User?              @relation(fields: [userId], references: [id], onDelete: SetNull)
  nutritions        FoodNutrition[] // Wartości odżywcze per 100g
  recipeIngredients RecipeIngredient[]

  @@index([namePl])
  @@index([nameEn])
  @@index([sourceProvider, sourceExternalId])
  @@map("foods")
}

// ============================================
// FOOD NUTRITION (wartości odżywcze per 100g)
// ============================================

model FoodNutrition {
  foodId      Int    @map("food_id")
  nutritionId String @map("nutrition_id")
  amount      Float // wartość per 100g w jednostce z Nutrition.unit

  food      Food      @relation(fields: [foodId], references: [id], onDelete: Cascade)
  nutrition Nutrition @relation(fields: [nutritionId], references: [id])

  @@id([foodId, nutritionId])
  @@map("food_nutrition")
}

// ============================================
// RECIPES (przepisy)
// ============================================

model Recipe {
  id              Int     @id @default(autoincrement())
  userId          Int     @map("user_id")
  namePl          String  @map("name_pl")
  nameEn          String? @map("name_en")
  descriptionPl   String? @map("description_pl") @db.Text
  descriptionEn   String? @map("description_en") @db.Text
  servings        Int     @default(1)
  prepTimeMinutes Int?    @map("prep_time_minutes")
  cookTimeMinutes Int?    @map("cook_time_minutes")
  difficulty      String? // easy, medium, hard
  isPublic        Boolean @default(true) @map("is_public")
  imageUrl        String? @map("image_url")
  slug            String  @unique
  awesomeness     Int? // 1-5 scale

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user         User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  ingredients  RecipeIngredient[]
  instructions Instruction[]
  tags         RecipeTag[]

  // Recipe composition relationship
  includesRecipes RecipeComponent[] @relation("IncludesRecipes")
  includedIn      RecipeComponent[] @relation("IncludedIn")

  @@index([userId])
  @@index([isPublic])
  @@index([slug])
  @@map("recipes")
}

// ============================================
// RECIPE INGREDIENTS (składniki w przepisie)
// ============================================

enum IngredientUnit {
  gram // g
  ml // ml
  liter // l
  kilogram // kg
  teaspoon // tsp
  tablespoon // tbsp
  cup // cup
  piece // pc
  pinch // pinch
  clove // clove (for garlic)
  slice // slice
  handful // handful
  can // can
  package // pkg

  @@map("ingredient_unit")
}

model RecipeIngredient {
  recipeId Int            @map("recipe_id")
  foodId   Int            @map("food_id")
  amount   Float? // optional amount
  unit     IngredientUnit @default(gram)
  notes    String? // np. "posiekany", "ugotowany"
  order    Int            @default(0)

  recipe Recipe @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  food   Food   @relation(fields: [foodId], references: [id], onDelete: Restrict)

  @@id([recipeId, foodId])
  @@map("recipe_ingredients")
}

// ============================================
// INSTRUCTIONS (kroki przepisu)
// ============================================

model Instruction {
  recipeId      Int     @map("recipe_id")
  stepNumber    Int     @map("step_number")
  descriptionPl String  @map("description_pl") @db.Text
  descriptionEn String? @map("description_en") @db.Text

  recipe Recipe @relation(fields: [recipeId], references: [id], onDelete: Cascade)

  @@id([recipeId, stepNumber])
  @@map("instructions")
}

// ============================================
// RECIPE COMPONENTS (przepisy składowe)
// ============================================

model RecipeComponent {
  recipeId    Int @map("recipe_id")    // parent recipe that includes the component
  componentId Int @map("component_id") // component recipe being included
  order       Int @default(0)          // preserve order

  recipe    Recipe @relation("IncludesRecipes", fields: [recipeId], references: [id], onDelete: Cascade)
  component Recipe @relation("IncludedIn", fields: [componentId], references: [id], onDelete: Cascade)

  @@id([recipeId, componentId])
  @@map("recipe_components")
}

// ============================================
// TAGS (kategorie, tagi)
// ============================================

model Tag {
  id     Int     @id @default(autoincrement())
  slug   String  @unique // url-safe slug from name_pl
  namePl String  @unique @map("name_pl")
  nameEn String? @map("name_en")

  recipes RecipeTag[]

  @@map("tags")
}

model RecipeTag {
  recipeId Int @map("recipe_id")
  tagId    Int @map("tag_id")

  recipe Recipe @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  tag    Tag    @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([recipeId, tagId])
  @@map("recipe_tags")
}
